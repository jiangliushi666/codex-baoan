{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Baoan",
  "version": "0.2.0",
  "identifier": "com.codexbaoan.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex 保安",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "MIT © jiangliushi666",
    "shortDescription": "Codex desktop guard",
    "longDescription": "Codex Baoan monitors Codex provider configuration and risky command behavior.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jiangliushi666/codex-baoan/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwQTkxNkM1RUVBMDU2NTQKUldSVVZxRHV4UmFwWU0rcGNXL1NFMFR1dzRpVjZSNHlRQ0xST09mSTRIZWR4Y1ViOEpvRkNud1IK"
    }
  }
}
